# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The address users open in the browser (local or your Vercel URL).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API. Next rewrites /api, /auth/confirm and /reset-password here.
# Local backend: http://localhost:3001
# Hosted API:    https://ai-interviewer-5kzg.onrender.com
# Required on Vercel too (set at build time).
BACKEND_URL=https://ai-interviewer-5kzg.onrender.com

# Cloudflare Turnstile site key. Test key always passes (pair with test secret in Supabase).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server only. Never expose this to the browser or prefix it with NEXT_PUBLIC_.
# Still used by the admin users page until it moves to the backend API.
SUPABASE_SERVICE_ROLE_KEY=

# Dev only, and only used while the Supabase keys above are empty.
# Set to "admin" to preview the admin area with the mock user.
# DEV_MOCK_ROLE=admin
