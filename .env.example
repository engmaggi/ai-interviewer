# Names match backend/.env.example, so one set of Vercel variables serves both services.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The address users open in the browser. Must equal the backend's NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local only: where the backend dev server runs (`cd backend && npm run dev -- -p 3001`).
# /api, /auth/confirm and /reset-password are rewritten there. Leave unset on Vercel.
BACKEND_URL=http://localhost:3001

# Cloudflare Turnstile site key. This test key always passes (pair it with the test secret in Supabase).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server only. Never expose this to the browser or prefix it with NEXT_PUBLIC_.
# Still used by the admin users page until it moves to the backend API.
SUPABASE_SERVICE_ROLE_KEY=

# Dev only, and only used while the Supabase keys above are empty.
# Set to "admin" to preview the admin area with the mock user.
# DEV_MOCK_ROLE=admin
