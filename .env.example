# Copy this file to `.env.local` and fill in the values (see docs/SETUP_GUIDE.md).
# `.env.local` is git-ignored. NEVER commit real keys.

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (Project Settings → API Keys) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Safe for the browser ("publishable" key, starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY — full power, bypasses RLS ("secret" key, starts with sb_secret_)
SUPABASE_SECRET_KEY=

# ── Database (click "Connect" in the Supabase dashboard → "Session pooler") ──
# Use the SESSION POOLER string (port 5432) for BOTH variables while developing.
# Keep the username as `postgres.YOUR-PROJECT-REF` (NOT a custom user).
# If your DB password contains special characters (@ : / # ?) URL-encode them.
# Do not add ?sslmode=... or ?pgbouncer=true — the code handles TLS itself.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Used only by `npm run db:migrate` (Prisma migrations). Same string as above.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Optional: PEM text of Supabase's CA certificate, to fully verify the DB connection.
# DATABASE_SSL_CA=

# ── API docs (Swagger UI at /api/docs) ───────────────────────────────────────
# On automatically in development; OFF in production unless you set this to true.
# ENABLE_API_DOCS=true

# ── Only used by `npm run admin:bootstrap` ───────────────────────────────────
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_NAME=Platform Admin
