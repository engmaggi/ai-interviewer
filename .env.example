# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser or prefix it with NEXT_PUBLIC_.
# Used by the admin module to create / edit / delete users.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for the email verification redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev only, and only used while the Supabase keys above are empty.
# Set to "admin" to preview the admin area with the mock user.
# DEV_MOCK_ROLE=admin
